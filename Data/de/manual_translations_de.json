  "help": {
    "title": "TYRIAN LENS",
    "sections": {
      "account": {
        "title": "KONTOVERBINDUNG & SCHLÜSSELEINSTELLUNGEN",
        "h_api": "API-Schlüssel-Integration",
        "p_api": "Tyrian Lens benötigt einen Guild Wars 2 API-Schlüssel, um Kontodaten sicher anzuzeigen. Erstellt einen Schlüssel im offiziellen ArenaNet-Portal. Für vollen Funktionsumfang sind folgende Berechtigungen nötig: account, inventories, characters, progression, wallet, unlocks und trading.",
        "h_visual": "Grafische Anpassung & Skalierung",
        "p_visual": "Passt die Benutzeroberfläche und Themen (Sylvari, Asura, Charr, Norn, Mensch) in den Einstellungen an. Linke Fenster (Karte, Timer, Farming) und rechte Fenster (Wiki, API, Einstellungen) agieren unabhängig voneinander.",
        "h_drf": "DRF Live-Beute-Integration",
        "p_drf": "(Optional) Verbindet den Farming-Tracker mit dem Drop Research Facilities (DRF) Addon für Live-Beuteerfassung. Drops werden während des Spielens ohne Verzögerung protokolliert."
      },
      "map": {
        "title": "INTERAKTIVE KARTEN & GPS-NAVIGATION",
        "h_mumble": "Mumble-Link Integration",
        "p_mumble": "Die Karten nutzen Guild Wars 2 Mumble-Link-Daten für Standortdienste. Die Karte springt automatisch zur Position eures Charakters und wechselt in Echtzeit zwischen Tyria und WvW.",
        "h_overlay": "Interaktive Karten-Overlays",
        "p_overlay": "Verwendet das Kartenoptionsfeld, um Symbole ein- oder auszublenden: Sammelknoten, Truhen, Tiergefährten, Händler und mehr! Ein Klick auf Händler zeigt deren Angebot.",
        "h_marker": "Eigene Kartenmarkierungen",
        "p_marker": "Platziert eigene Markierungen mit ALT + LINKSKLICK. Ein Klick auf die gesetzte Markierung entfernt sie wieder."
      },
      "storage": {
        "title": "KONTOWEITE LAGERUNG & SUCHE",
        "h_search": "Einheitliche Kontosuche",
        "p_search": "Durchsucht Bank, Materiallager, gemeinsame Inventarplätze und alle Charakterinventare gleichzeitig über ein zentrales Suchfeld.",
        "h_roster": "Charakterliste & Inventare",
        "p_roster": "Prüft Taschenplätze, Ausrüstung, Geburtstags-Countdowns und Spielzeit aller Charaktere, ohne im Spiel umloggen zu müssen.",
        "h_mat": "Materiallager & Garderobe",
        "p_mat": "Durchstöbert Sammlungen, freigeschaltete Skins und Handwerksmaterialien. Klickt auf Gegenstände, um das offizielle Guild Wars 2 Wiki zu öffnen."
      },
      "hero": {
        "title": "HELDENÜBERSICHT & THEORIE-BUILDS",
        "h_equip": "Ausrüstung & Attribute",
        "p_equip": "Prüft ausgerüstete Waffen, Rüstungen und Zubehör mit vollständigen Werten und Seltenheitsfarben.",
        "h_specs": "Spezialisierungen & Fertigkeiten",
        "p_specs": "Seht ausgewählte Eigenschaften und Fertigkeiten eurer geladenen Vorlagen direkt in der Übersicht.",
        "h_planner": "Interaktiver Build-Planer",
        "p_planner": "Plant eure Builds und Ausrüstungssets. Testet Eigenschaftslinien und Wertekombinationen und teilt sie bequem mit Freunden."
      },
      "trading": {
        "title": "HANDELSPOSTEN & WIRTSCHAFT",
        "h_delivery": "Abholkasten-Benachrichtigung",
        "p_delivery": "Das Handelssymbol weist darauf hin, wenn Gegenstände oder Gold abholbereit sind. Fahrt mit der Maus darüber für eine genaue Auflistung.",
        "h_charts": "Investitionsdiagramme & Markt",
        "p_charts": "Verfolgt Kauf- und Verkaufsaufträge sowie Preisverläufe. Der Portfolio-Tracker berechnet Gewinn- und Renditediagramme.",
        "h_crafting": "Intelligenter Handwerksrechner",
        "p_crafting": "Berechnet Nettogewinne unter Berücksichtigung von Materialien, die sich bereits in eurer Bank oder eurem Lager befinden."
      },
      "events": {
        "title": "EVENTS, WELTBOSSE & FORTSCHRITT",
        "h_meta": "Meta-Beobachtungsliste & Boss-Timer",
        "p_meta": "Überwacht Weltboss-Zeitpläne und aktive Meta-Events. Klickt auf das Augensymbol einer Karte, um sie zur Countdown-Beobachtungsliste hinzuzufügen.",
        "h_achieve": "Erfolgs-Dashboard",
        "p_achieve": "Verfolgt eure Erfolge mit Fortschrittsbalken je Kategorie und Details zu einzelnen Rängen.",
        "h_clears": "Wöchentliche Boss-Clears",
        "p_clears": "Behaltet eure Raids, Angriffsmissionen und Verliese im Auge. Die Anzeige zeigt abgeschlossene und offene Bosse des Zyklus.",
        "h_farming": "Sitzungs-Farming-Tracker",
        "p_farming": "Startet Farm-Sitzungen zur Aufzeichnung von Gold pro Stunde, Währungsschwankungen und erbeuteten Gegenständen in Echtzeit."
      },
      "credits": {
        "title": "DANKSAGUNG & RECHTLICHES",
        "h_copy": "Urheberrechtshinweis",
