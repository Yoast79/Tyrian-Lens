  "help": {
    "title": "TYRIAN LENS",
    "sections": {
      "account": {
        "title": "ACCOUNT CONNECTION & KEY SETTINGS",
        "h_api": "API Key Integration",
        "p_api": "Tyrian Lens requires a Guild Wars 2 API key to display your account data securely. Create a key at the official ArenaNet account portal. For full functionality, your key requires the following permissions: account, inventories, characters, progression, wallet, unlocks, and trading.",
        "h_visual": "Visual Customization & Scale",
        "p_visual": "Adjust scaling preferences and select interface themes (Sylvari, Asura, Charr, Norn, Human) within settings. Left-hand panels (Map, Timers, Farming) and right-hand panels (Wiki, API, Settings) act independently, allowing you to run layouts on both sides of the screen simultaneously.",
        "h_drf": "DRF Live Loot Integration",
        "p_drf": "(Optional) Link the Farming Tracker with the Drop Research Facilities (DRF) addon to enable live drop tracking. This automatically logs all item drops during grinding sessions without delay. The tracker will still work without this, but you have to wait for the GW2 API to refresh."
      },
      "map": {
        "title": "INTERACTIVE MAPS & GPS NAVIGATION",
        "h_mumble": "Mumble Link Client Integration",
        "p_mumble": "The Leaflet-powered maps use Guild Wars 2 Mumble Link data for live location services. The map automatically snaps to your active character's location, tracks coordinate changes, and shifts between Tyria and WvW layers in real time.",
        "h_overlay": "Interactive Map Overlays",
        "p_overlay": "Use the map options panel to toggle many icons on the map like: gathering nodes, chests, ranger pet locations, service NPCs and many more! Clicking a NPC icon will show you the items they are selling.",
        "h_marker": "Personal Map Markers",
        "p_marker": "You can place custom icons directly onto the map. Use ALT + LEFT CLICK to drop a waypoint, and click directly on the placed marker to remove it."
      },
      "storage": {
        "title": "ACCOUNT WIDE STORAGE & SEARCH",
        "h_search": "Unified Account Search",
        "p_search": "Search and filter your entire bank, material storage, shared slots, and individual character inventories simultaneously from a single search box.",
        "h_roster": "Character Roster & Inventories",
        "p_roster": "Check bag slots, equipment, birthday countdowns, and playtime across your entire character roster without having to swap characters in-game.",
        "h_mat": "Material Storage & Wardrobes",
        "p_mat": "Browse account-wide collections, skin unlocks, and crafting material quantities. Click on items to open their official Guild Wars 2 Wiki entries."
      },
      "hero": {
        "title": "HERO PANEL & BUILD THEORYCRAFTING",
        "h_equip": "Live Hero Equipment & Attributes",
        "p_equip": "Inspect equipped weapons, armor, and accessories. Dynamic tooltips supply full item stats and match item rarity colors.",
        "h_specs": "Specializations & Builds",
        "p_specs": "View slotted specializations, selected traits, and active utility skills. You can review your loaded template properties directly in the interface.",
        "h_planner": "Interactive Build Planner",
        "p_planner": "Plan your builds and theorycraft gear sets using the layout editor. Check custom trait lines, stats distributions, and utility combinations. Share them easily with your friends."
      },
      "trading": {
        "title": "TRADING POST & ECONOMY DATA",
        "h_delivery": "Delivery Box Notification",
        "p_delivery": "The Trading Post navigation icon updates to a notification graphic when you have items or gold waiting. Hover over the icon to display an exact breakdown of total waiting items and formatted coin values.",
        "h_charts": "Investment Charts & Markets",
        "p_charts": "Track buy and sell orders, historical price updates, and active TP listings. The portfolio tracker plots profit and return-on-investment (ROI) charts for saved item investments.",
        "h_crafting": "Smart Crafting Engine",
        "p_crafting": "Calculate net crafting profits by cross-referencing live market pricing against materials already inside your personal bank and material storage."
      },
      "events": {
        "title": "EVENTS, BOSSES & PROGRESSION",
        "h_meta": "Meta Watchlist & Boss Timers",
        "p_meta": "Monitor world boss schedules and active meta timelines. Click on any boss card to add it to your permanent countdown watchlist overlay.",
        "h_achieve": "Achievements Dashboard",
        "p_achieve": "Track overall achievements. The dashboard displays progress meters by category, along with completion details for individual achievement tiers.",
        "h_clears": "Weekly Boss Clears",
        "p_clears": "Keep tabs on your raids, strike missions, and dungeon progress. The matrix updates automatically to show completed and remaining targets for the weekly cycle.",
        "h_farming": "Session Farming Tracker",
        "p_farming": "Start grinding sessions to record gold-per-hour, total currency fluctuations, and logged item drops in real-time (when the DRF module is installed)."
      },
      "credits": {
        "title": "CREDITS & LEGAL DISCLAIMERS",
        "h_copy": "Copyright Notice",
        "p_copy": "All Guild Wars 2 assets, imagery, and API content are owned by ArenaNet and NCSOFT.",
        "h_arch": "Software Architecture",
        "p_arch": "Built using C#, .NET 9, WebView2 runtime interfaces and Leaflet JS.",
        "h_dep": "Core Dependencies",
        "p_dep": "Powered by the Gw2Sharp library for local Mumble Link integration.",
        "h_insp": "Inspirations",
        "p_insp": "Inspired by the work of gw2efficiency, gw2navi, and drf.rs.",
        "h_contrib": "Coordinate Contributions",
        "p_contrib": "Map coordinate files provided by Lady Elyssa and Tekkit."
      },
